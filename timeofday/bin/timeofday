#!/usr/bin/env python3
import ast, json, subprocess, sys, tomllib
from datetime import datetime
from pathlib import Path

CONF   = Path.home() / ".config/timeofday/config.toml"
CACHE  = Path.home() / ".cache/timeofday"
EXT_ID = "live-lockpaper@DeLuca21"
SCHEMA = "org.gnome.shell.extensions.live-lockpaper-deluca21"
EXT_DIRS = [
    Path.home() / ".local/share/gnome-shell/extensions" / EXT_ID,
    Path("/usr/share/gnome-shell/extensions") / EXT_ID,
]

def load():
    return tomllib.loads(CONF.read_text())

def current_slot(slots):
    hour = datetime.now().astimezone().hour
    ordered = sorted(slots.items(), key=lambda kv: kv[1])
    slot = ordered[-1][0]
    for name, start in ordered:
        if hour >= start:
            slot = name
    return slot

def still_for(slot, clip):
    CACHE.mkdir(parents=True, exist_ok=True)
    still = CACHE / f"{slot}.jpg"
    if not still.exists():
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-ss", "1",
             "-i", str(Path(clip).expanduser()), "-frames:v", "1", str(still)],
            check=True)
    return still

def set_still(still):
    uri = still.as_uri()
    for key in ("picture-uri", "picture-uri-dark"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", key, uri],
                       check=True)

def schema_dir():
    for d in EXT_DIRS:
        if (d / "schemas").is_dir():
            return d / "schemas"
    return None


def gv_str(s):
    """Quote a string as GVariant text."""
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


def ext_get(sd, key):
    r = subprocess.run(["gsettings", "--schemadir", str(sd), "get", SCHEMA, key],
                       capture_output=True, text=True, check=True)
    return r.stdout.strip()


def ext_set(sd, key, value):
    subprocess.run(["gsettings", "--schemadir", str(sd), "set", SCHEMA, key, value],
                   check=True)


def set_video(clip):
    sd = schema_dir()
    if sd is None:
        print("LiveLockPaper not found; still image only")
        return
    clip = str(Path(clip).expanduser().resolve())
    changed = False

    try:
        current = json.loads(ast.literal_eval(ext_get(sd, "wallpaper-per-monitor-config")))
    except (ValueError, SyntaxError):
        current = {}
    wanted = {mon: [clip] for mon in current}
    if wanted and current != wanted:
        ext_set(sd, "wallpaper-per-monitor-config",
                gv_str(json.dumps(wanted, separators=(",", ":"))))
        changed = True

    try:
        paths = ast.literal_eval(ext_get(sd, "wallpaper-video-paths"))
    except (ValueError, SyntaxError):   # empty list prints as "@as []"
        paths = []
    if paths != [clip]:
        ext_set(sd, "wallpaper-video-paths", "[" + gv_str(clip) + "]")
        changed = True

    print("Video: switched" if changed else "Video: unchanged")


def main():
    cfg = load()
    slot = sys.argv[1] if len(sys.argv) > 1 else current_slot(cfg["slots"])
    clip = cfg["clips"][slot]
    set_still(still_for(slot, clip))
    set_video(clip)
    print(f"Applied: {slot}")


if __name__ == "__main__":
    main()
